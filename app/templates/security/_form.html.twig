<!-- login Area Strat-->
<section class="login-area pt-100 pb-100">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 offset-lg-2">
                <div class="basic-login">
                    <h3 class="text-center mb-60">Connexion</h3>
                    <form action="{{ path('front_login') }}" method="POST" autocomplete="off">
                        <label for="inputEmail">Email</label>
                        <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus>
                        <label for="inputPassword">Password</label>
                        <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>

                        <input type="hidden" name="_csrf_token"
                               value="{{ csrf_token('authenticate') }}"
                        >

                        <div class="login-action mb-20 fix">
                                    <span class="log-rem f-left">
                                        <input id="remember" name="_remember_me" type="checkbox" />
                                        <label for="remember">Se souvenir de moi !</label>
                                    </span>
                            <span class="forgot-login f-right">
                                        <a href="#">Mot de pass oublié ?</a>
                                    </span>
                        </div>
                        <button class="os-btn w-100">Connexion</button>
                        <div class="or-divide"><span>ou</span></div>
                        <a href="{{ path('front_pre_registration') }}" class="os-btn os-btn-black w-100">S'inscrire</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- login Area End-->