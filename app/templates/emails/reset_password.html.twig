{% block subject %}RENTED – Demande de réinitialisation de votre mot de passe{% endblock %}

{% block body_html %}
    {% embed 'emails/_layout.html.twig' %}
        {% block title %}Demande de réinitialisation de votre mot de passe{% endblock %}
        {% block accroche %}Réinitialisation du mot de passe{% endblock %}
        {% block body %}
            <h1>Hi!</h1>

            <p>To reset your password, please visit the following link</p>

            <a href="{{ url('front_reset_password', {token: resetToken.token}) }}">{{ url('app_reset_password', {token: resetToken.token}) }}</a>

            <p>This link will expire in {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.</p>

            <p>Cheers!</p>
        {% endblock %}
    {% endembed %}
{% endblock %}


{% block body_text %}
    Bonjour,\n
    \n
    To reset your password, please visit the following link\n
    \n
    {{ url('front_reset_password', {token: resetToken.token}) }}">{{ url('app_reset_password', {token: resetToken.token}) }}\n
    \n
    This link will expire in {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.\n
    \n
    Cheers!\n
    \n
    Ce message est généré automatiquement, merci de ne pas y répondre directement.\n
{% endblock %}