<div class="panel panel-inverse">
    <div class="panel-heading">
        <h4 class="panel-title">Transactions</h4>
    </div>
    <div class="panel-body">
        <div class="table-responsive mb-4">
            <table class="user-company table table-striped m-b-0">
                <thead>
                <tr>
                    <th>Id Produit</th>
                    <th>Titre</th>
                    <th>Date de début</th>
                    <th>Date de fin</th>
                    <th>Quantité</th>
                    <th>Mont. TTC</th>
                    <th>Mont. T.V.A</th>
                    <th>Frais</th>
                    <th>Statut</th>-
                    <th>Propriétaire</th>
                    <th style="width: 50px;"></th>
                </tr>
                </thead>
                <tbody>
                {% for transactionLine in transaction.transactionLines %}
                    <tr>
                        <td><a href="{{ path('back_product_show', {id:  transactionLine.product.id}) }}">{{ transactionLine.product.id|default('') }}</a></td>
                        <td><a href="{{ path('back_product_show', {id:  transactionLine.product.id}) }}">{{ transactionLine.product.title|default('') }}</a></td>
                        <td>{{ transactionLine.startDate|date('d-m-Y') }}</td>
                        <td>{{ transactionLine.endDate|date('d-m-Y') }}</td>
                        <td>{{ transactionLine.quantity|default('') }}</td>
                        <td>{{ (transactionLine.amountTtc / 100)|number_format(2, ',')|default('') }}</td>
                        <td>{{ (transactionLine.amountTva / 100)|number_format(2, ',')|default('') }}</td>
                        <td>{{ (transactionLine.fees / 100)|number_format(2, ',')|default('') }}</td>
                        <td>{{ transactionLine.status.label|default('') }}</td>
                        <td><a href="{{ path('back_lessor_show', {id: transactionLine.product.author.id}) }}">{{ transactionLine.product.author.fullname|default('') }}</a></td>
                        <td class="pl-4">
                            {#                                <a title="Suppression" #}
                            {#                                   href="{{ path('back_company_delete_user_company', {'customerCompany': customerCompany.id, 'customerAccount' : account.id}) }}" #}
                            {#                                   class="btn btn-xs btn-danger post-confirm" #}
                            {#                                   data-button-text="Suppression" #}
                            {#                                   data-title="Suppression" #}
                            {#                                   data-confirm-message="Souhaitez-vous supprimer cet élément ?"> #}
                            {#                                    <i class="fa fa-trash"></i> #}
                            {#                                </a> #}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
