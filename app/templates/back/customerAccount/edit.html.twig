{% extends 'back/layout.html.twig' %}

{% block title %}Création d'un compte client - {{ parent() }}{% endblock %}
{% block page_title %}Création d'un compte client {% endblock %}

{% set breadcrumbItems = {
    'Clients': path('back_company_index'),
    'Création d\'un compte client' : ''
} %}

{% block action_buttons %}
    <a title="retour sur le contenu" href="{{ path('back_company_index') }}"
       class="btn btn-xs btn-primary">
        <i class="fa fa-arrow-left"></i>&nbsp; Retour
    </a>
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-xl-12">
            <div class="panel panel-inverse">
                <div class="panel-heading">
                    <h4 class="panel-title">Edition</h4>
                </div>
                <div class="panel-body">
                    <div class="row col-12">
                        <div class="col-lg-12 text-left">
                            <h2>Informations générales</h2>
                        </div>
                    </div>
                    {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'autocomplete': 'fake-name-disable-autofill'}}) }}
                    <div class="row col-12">
                        <div class="col-xs-12 col-lg-6">
                            <div class="form-group">
                                {{ form_label(form.company.siret) }}
                                <div class="row">
                                    <div class="col-xs-9">
                                        {{ form_widget(form.company.siret) }}
                                    </div>
                                    <div class="col-xs-3">
                                        <button type="button" class="btn btn-primary w-100" id="sage-check">
                                            Vérifier
                                        </button>
                                    </div>
                                </div>
                                <p class="mt-2 text-green-darker font-weight-bold" id="sage-message">
                                </p>
                            </div>
                            {{ form_row(form.company.sageCode) }}
                        </div>
                        <div class="col-xs-12 col-lg-6">
                            {{ form_row(form.company.companyName) }}
                            {{ form_row(form.company.naf) }}

                        </div>
                    </div>
                    <div class="row col-12">
                        <div class="col-xs-12 col-lg-6">
                            {{ form_row(form.company.vatIdentifier) }}
                            {{ form_row(form.company.legalForm) }}
                            {{ form_row(form.company.leaderCivility) }}
                            <div class="row">
                                <div class="col-xs-6">
                                    {{ form_row(form.company.leaderLastname) }}
                                </div>
                                <div class="col-xs-6">
                                    {{ form_row(form.company.leaderFirstname) }}
                                </div>
                            </div>
                            {{ form_row(form.company.billingEmail) }}
                        </div>
                        <div class="col-xs-12 col-lg-6">
                            {{ form_row(form.company.companyFoundedDate) }}
                            {{ form_label(form.company.mainAddress.address) }}
                            {{ form_widget(form.company.mainAddress.address) }}
                            <div class="mt-1">
                                {{ form_widget(form.company.mainAddress.addressAdditional) }}
                            </div>
                            <div class="row mt-1">
                                <div class="col-xs-4">
                                    {{ form_widget(form.company.mainAddress.zipcode) }}
                                </div>
                                <div class="col-xs-8">
                                    {{ form_widget(form.company.mainAddress.city) }}
                                </div>
                            </div>
                            <div class="mt-2 mb-3">
                                {{ form_widget(form.company.mainAddress.country) }}
                            </div>
                            {{ form_row(form.company.phoneNumber) }}
                            {{ form_row(form.company.website) }}
                            {{ form_row(form.company.certificateEmail) }}
                        </div>
                    </div>
                    <div class="row col-12">
                        <div class="col-xs-12 col-lg-6" >

                            <div class="referent-journalists">
                                <div class="form-group group-autocomplete left-position">
                                    <label class="col-sm-12 control-label">
                                        <b>Propriétaire</b>
                                    </label>
                                    <label class="col-sm-12 control-label">
                                        Sélectionner un membre existant :
                                    </label>
                                    <div class="col-sm-12">
                                        <div class="input-group">
                                            <input type="text" class="form-control control-autocomplete-referent">
                                            <span class="input-group-btn">
                                                <button class="float-right btn btn-info add-journalist"
                                                        type="button">+</button>
                                            </span>
                                        </div><!-- /input-group -->
                                        <span class="help-block hidden d-none">
                                            <ul class="list-unstyled">
                                                <li><i class="fa fa-exclamation-circle"></i> Veuillez choisir un membre.</li>
                                            </ul>
                                        </span>
                                    </div>
                                </div>
                                <table class="table table-bordered">
                                    <thead>
                                    <tr>
                                        <th class="text-center">Membre sélectionné</th>
                                        <th></th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% if form.vars.data.company %}
                                        {% set users = get_ordered_users(form.vars.data.company) %}
                                        {% for user in users %}
                                            {% include 'back/customerAccount/_user.html.twig' with {user: user} only %}
                                        {% endfor %}
                                    {% endif %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="col-xs-12 col-lg-6">
                            <label class="col-sm-12 control-label left-position">
                                Ou créer un nouveau membre :
                            </label>
                            {{ form_row(form.user.lastname) }}
                            {{ form_row(form.user.firstname) }}
                            {{ form_row(form.user.email) }}
                            {{ form_row(form.user.phoneNumber) }}
                            <div class="form-group">
                                {{ form_label(form.user.plainPassword) }}
                                <div class="input-group password-show-and-hide">
                                    {{ form_widget(form.user.plainPassword) }}
                                    <div class="input-group-addon">
                                        <a href=""><i class="fa fa-eye-slash" aria-hidden="true"></i></a>
                                    </div>
                                </div>
                                {{ form_errors(form.user.plainPassword) }}
                            </div>
                            {{ form_rest(form.user) }}
                        </div>
                    </div>
                    <div class="actions mt-4 text-center">
                        <input type="submit" value="Enregistrer" class="btn btn-primary"/>
                    </div>
                    {{ form_rest(form) }}
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% for file in encore_entry_js_files('back_customers') %}
        <script src="{{ asset(file) }}"></script>
    {% endfor %}
{% endblock %}
