{% extends 'back/layout.html.twig' %}
{% import "front/macros/macros.html.twig" as macros %}

{% block title %}Configuration de la Home page - {{ parent() }}{% endblock %}
{% block page_title %}Configuration de la Home page {% endblock %}

{% block action_buttons %}
    <a title="Retour sur le contenu" href="{{ path('back_home_dashboard') }}"
       class="btn btn-xs btn-primary">
        <i class="fa fa-arrow-left"></i>&nbsp; Retour
    </a>
{% endblock %}

{% block content %}
    <div class="row" {{ stimulus_controller('back-homepage') }}>
        <div class="col-xl-12">
            {{ form_start(form, {attr: {'autocomplete':'off'}}) }}
            <div class="panel panel-inverse">
                <div class="panel-heading">
                    <h4 class="panel-title">Sliders</h4>
                    <button type="button" class="btn btn-primary btn-sm"
                            title="Ajouter des produits au slider"
                            data-action="click->back-homepage#onSlidersAdd">
                        Ajouter <i class="fas fa-plus "></i>
                    </button>
                </div>
                <div class="panel-body">
                    <div class="row col-12">
                        <div class="col-xs-12 col-lg-4">
                            {{ form_widget(form.sliders1) }}
                            {{ form_errors(form.sliders1) }}
                        </div>
                        <div class="col-xs-12 col-lg-4">
                            {{ form_widget(form.sliders2) }}
                            {{ form_errors(form.sliders2) }}
                        </div>
                        <div class="col-xs-12 col-lg-4">
                            {{ form_widget(form.sliders3) }}
                            {{ form_errors(form.sliders3) }}
                        </div>
                    </div>
                </div>
                <div class="panel-heading">
                    <h4 class="panel-title">Under Sliders</h4>
                    <button type="button" class="btn btn-primary btn-sm"
                            title="Ajouter des photos à votre produit"
                            data-action="click->back-homepage#onUnderSlidersAdd">
                        Ajouter <i class="fas fa-plus "></i>
                    </button>
                </div>
                <div class="panel-body">
                    <div class="row col-12">
                        <div class="col-xs-12 col-lg-4">
                            {{ form_widget(form.underSliders1) }}
                            {{ form_errors(form.underSliders1) }}
                        </div>
                        <div class="col-xs-12 col-lg-4">
                            {{ form_widget(form.underSliders2) }}
                            {{ form_errors(form.underSliders2) }}
                        </div>
                        <div class="col-xs-12 col-lg-4">
                            {{ form_widget(form.underSliders3) }}
                            {{ form_errors(form.underSliders3) }}
                        </div>
                    </div>
                </div>
                <div class="panel-heading">
                    <h4 class="panel-title">Mids</h4>
                    <button type="button" class="btn btn-primary btn-sm"
                            title="Ajouter des photos à votre produit"
                            data-action="click->back-homepage#onMidsAdd">
                        Ajouter <i class="fas fa-plus "></i>
                    </button>
                </div>
                <div class="panel-body">
                    <div class="row col-12">
                        <div class="col-xs-12 col-lg-6">
                            {{ form_widget(form.mids1) }}
                            {{ form_errors(form.mids1) }}
                        </div>
                        <div class="col-xs-12 col-lg-6">
                            {{ form_widget(form.mids2) }}
                            {{ form_errors(form.mids2) }}
                        </div>
                    </div>
                </div>
            </div>
            <div class="actions mt-4 text-center col-12 pb-2">
                <button type="submit" class="btn btn-primary" formnovalidate>Valider le produit</button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
    </div>
    </div>
{% endblock %}
