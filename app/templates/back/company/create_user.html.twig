{{ form_start(form, {'attr': { 'novalidate': 'novalidate', 'autocomplete': 'fake-name-disable-autofill'}}) }}

<div class="row col-12">
    <div class="col-xs-12 col-lg-6">
        <div class="referent-journalists">
            <div class="form-group group-autocomplete" style="position: relative;left:-15px;">
                <label class="col-sm-12 control-label">
                    Sélectionner un membre existant :
                </label>
                <div class="col-sm-12">
                    <div class="input-group">
                        <input type="text" class="form-control control-autocomplete-referent">
                        <span class="input-group-btn">
                            <button class="float-right btn btn-info add-journalist"
                                    type="button">+</button>
                        </span>
                    </div><!-- /input-group -->
                    <span class="help-block hidden d-none">
                        <ul class="list-unstyled">
                            <li><i class="fa fa-exclamation-circle"></i> Veuillez choisir un membre.</li>
                        </ul>
                    </span>
                </div>
            </div>
            <table class="table table-bordered">
                <thead>
                <tr>
                    <th class="text-center">Membre sélectionné</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {% if form.vars.data %}
                    {% set users = get_ordered_users_modal(form.vars.data) %}
                    {% for user in users %}
                        {% include 'back/customerAccount/_user.html.twig' with {user: user} only %}
                    {% endfor %}
                {% endif %}
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-xs-12 col-lg-6">
        <label class="col-sm-12 control-label" style="position: relative;left:-15px;">
            Ou créer un nouveau membre :
        </label>
        {{ form_row(form.lastname) }}
        {{ form_row(form.firstname) }}
        {{ form_row(form.email) }}
        {{ form_row(form.phoneNumber) }}

        <div class="form-group">
            {{ form_label(form.plainPassword) }}
            <div class="input-group password-show-and-hide">
                {{ form_widget(form.plainPassword) }}
                <div class="input-group-addon">
                    <a href=""><i class="fa fa-eye-slash" aria-hidden="true"></i></a>
                </div>
            </div>
            {{ form_errors(form.plainPassword) }}
        </div>
    </div>
</div>

<div class="actions mt-4 text-center">
    <input type="submit" value="Enregistrer" class="btn btn-primary"/>
</div>

{{ form_end(form) }}
