{% extends 'back/layout.html.twig' %}

{% block title %}Fiche de {{ customerCompany.companyName|upper }} - {{ parent() }}{% endblock %}
{% block page_title %}Fiche de {{ customerCompany.companyName|upper }} {% endblock %}

{% set breadcrumbItems = {
    'Clients': path('back_company_index'),
    ('Fiche de ') ~ (customerCompany.companyName|upper) : ''
} %}

{% block action_buttons %}
    <a title="retour sur le contenu" href="{{ path('back_company_index') }}"
       class="btn btn-xs btn-primary">
        <i class="fa fa-arrow-left"></i>&nbsp; Retour
    </a>
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-xl-12">
            {% if hasValidCertificates %}
                <div class="alert alert-danger">
                    <i class="fa fa-exclamation-triangle mr-2"></i>
                    Ce client possède des certificats en cours. Pour toute modification des informations de l’entreprise,
                    il est préférable d’utiliser Thotem.
                </div>
            {% endif %}

            <div class="panel panel-inverse">
                <div class="panel-heading">
                    <h4 class="panel-title">Edition</h4>
                </div>
                <div class="panel-body">
                    <div class="row col-12">
                        <div class="col-lg-7 text-left">
                            <h2>Informations générales</h2>
                        </div>
                        <div class="col-lg-5 text-right">
                            <a class="btn btn-outline-primary" href="{{ path('back_company_authenticate', {'id': customerCompany.id}) }}">
                                <i class="fa fa-user"></i> Se connecter avec ce client
                            </a>
                            <div>
                                <small><i class="fa fa-exclamation-triangle"></i> <em>N'ouvrir qu'une seule fenêtre à la fois.</em></small>
                            </div>
                        </div>
                    </div>
                    {{ form_start(form, {'attr': { 'novalidate': 'novalidate'}}) }}
                    <div class="row col-12">
                        <div class="col-xs-12 col-lg-6">
                            {{ form_row(form.sageCode) }}
                            {{ form_row(form.siret) }}
                            {{ form_row(form.vatIdentifier) }}
                            {{ form_row(form.legalForm) }}
                            {{ form_row(form.leaderCivility) }}
                            <div class="row">
                                <div class="col-xs-6">
                                    {{ form_row(form.leaderLastname) }}
                                </div>
                                <div class="col-xs-6">
                                    {{ form_row(form.leaderFirstname) }}
                                </div>
                            </div>
                            {{ form_row(form.billingEmail) }}
                            {{ form_row(form.website) }}
                        </div>
                        <div class="col-xs-12 col-lg-6">
                            {{ form_row(form.companyName) }}
                            {{ form_row(form.naf) }}
                            {{ form_row(form.companyFoundedDate) }}
                            {{ form_label(form.mainAddress.address) }}
                            {{ form_widget(form.mainAddress.address) }}
                            <div class="mt-1">
                                {{ form_widget(form.mainAddress.addressAdditional) }}
                            </div>
                            <div class="row mt-1">
                                <div class="col-xs-4">
                                    {{ form_widget(form.mainAddress.zipcode) }}
                                </div>
                                <div class="col-xs-8">
                                    {{ form_widget(form.mainAddress.city) }}
                                </div>
                            </div>
                            <div class="mt-2 mb-3">
                                {{ form_widget(form.mainAddress.country) }}
                            </div>
                            {{ form_row(form.phoneNumber) }}
                            {{ form_row(form.certificateEmail) }}
                        </div>
                    </div>
                    <div class="actions mt-4 text-center">
                        <input type="submit" value="Enregistrer" class="btn btn-primary"/>
                    </div>
                    {{ form_end(form) }}
                </div>
                <!-- include list -->
                {{ include('back/company/list.html.twig') }}
                <!-- end include -->
                <!-- include delete button -->
                {{ include('back/company/_delete_form.html.twig') }}
                <!-- end include -->
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% for file in encore_entry_js_files('back_customers') %}
        <script src="{{ asset(file) }}"></script>
    {% endfor %}
{% endblock %}
