{% extends 'back/layout.html.twig' %}

{% block title %}Clients - {{ parent() }}{% endblock %}
{% block page_title %}Clients ({{ companys.totalItemCount() }}){% endblock %}
{% block action_buttons %}
    <a title="Exporter" href="{{ path('back_company_extract_company') }}" class="btn btn-info">
        Exporter
    </a>
    <a title="Nouveau client" href="{{ path('back_company_create') }}" class="btn btn-info">
        <i class="fa fa-plus"></i> Nouveau client
    </a>
{% endblock %}

{% block form_filter %}
    {{ form_start(filterForm, {'attr': {'novalidate':'novalidate', 'style' : 'position:relative;top:-12px;'}}) }}
    <button type="submit" class="btn btn-success float-right">
        <i class="fa fa-search"></i>&nbsp
    </button>
    {{ form_row(filterForm.term) }}
    {{ form_end(filterForm) }}
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-12">
            <div class="panel panel-inverse">
                <div class="panel-heading ui-sortable-handle">
                    <h4 class="panel-title">Clients</h4>
                </div>
                <div class="panel-body">
                    <div class="table-responsive mb-4">
                        <table class="client-list table table-striped m-b-0">
                            <thead>
                            <tr>
                                <th>Siret / N° identification</th>
                                <th>Raison Sociale</th>
                                <th>N° client sage</th>
                                <th>Nom du propriétaire</th>
                                <th>Email du propriétaire</th>
                                <th>Téléphone</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for company in companys %}
                                <tr class="customer-row"
                                    data-href="{{ path('back_company_edit', {'id': company.id }) }}">
                                    <td>{{ company.siret }}</td>
                                    <td>{{ company.companyName }}</td>
                                    <td>{{ company.sageCode }}</td>
                                    <td>{{ company.owner.user.lastname ~ ' ' ~ company.owner.user.firstname }}</td>
                                    <td>{{ company.owner.user.email }}</td>
                                    <td>{{ company.owner.user.phoneNumber }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="navigation">
                        {{ knp_pagination_render(companys) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    {% for file in encore_entry_js_files('back_customers') %}
        <script src="{{ asset(file) }}"></script>
    {% endfor %}
{% endblock %}
