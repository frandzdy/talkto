<div class="panel panel-inverse">
    <div class="panel-heading">
        <h4 class="panel-title">Utilisateurs</h4>
        <div class="panel-heading-btn">
            <a title="Nouveau membre"
               href="{{ path('back_company_create_user_company', {'company': customerCompany.id}) }}"
               class="btn btn-xs btn-primary open-back-modal"
               data-lg-size="true"
               data-modal-title="Nouveau membre">
                <i class="fa fa-plus"></i> Nouveau Membre
            </a>
        </div>
    </div>
    <div class="panel-body">
        <div class="table-responsive mb-4">
            <table class="user-company table table-striped m-b-0">
                <thead>
                <tr>
                    <th>Nom du contact</th>
                    <th>Profil</th>
                    <th>E-mail</th>
                    <th>Téléphone</th>
                    <th>Statut</th>
                    <th style="width: 50px;"></th>
                    <th style="width: 50px;"></th>
                </tr>
                </thead>
                <tbody>
                {% for account in customerCompany.accounts %}
                    {% if account.user %}
                        <tr>
                            <td>{{ account.user.fullname|default('') }}</td>
                            <td>
                                <div class="radio radio-css radio-inline">
                                    <input {% if account.owner %}checked="checked"{% endif %}
                                           data-href="{{ path('back_company_change_company_owner', {'customerCompany': customerCompany.id, 'customerAccount': account.id}) }}"
                                           type="radio" name="owner" class="change-owner"
                                           id="owner-user{{ account.user.id }}" value="{{ account.owner }}"/>
                                    <label for="owner-user{{ account.user.id }}">Propriétaire</label>
                                </div>
                            </td>
                            <td>{{ account.user.email }}</td>
                            <td>{{ account.user.phoneNumber }}</td>
                            <td>
                                <!-- switcher -->
                                <div class="switcher">
                                    <input {% if account.status == constant('App\\Entity\\CustomerAccount::STATUS_ACTIVE') %}checked="checked"{% endif %}
                                           data-href="{{ path('back_company_change_user_status', {id : account.id}) }}"
                                           type="checkbox" name="status" class="change-user-status"
                                           id="status-user{{ account.id }}" value="{{ account.status }}">
                                    <label for="status-user{{ account.id }}"></label>
                                </div>
                            </td>
                            <td class="pl-4">
                                <a title="Edition d'un utilisateur"
                                   href="{{ path('back_company_edit_user_company', {'user': account.user.id, 'company': account.company.id}) }}"
                                   class="btn btn-xs btn-primary open-back-modal"
                                   data-modal-title="Edition d'un utilisateur">
                                    <i class="fa fa-pencil-alt"></i>
                                </a>
                            </td>
                            <td class="pl-4">
                                <a title="Suppression"
                                   href="{{ path('back_company_delete_user_company', {'customerCompany': customerCompany.id, 'customerAccount' : account.id}) }}"
                                   class="btn btn-xs btn-danger post-confirm"
                                   data-button-text="Suppression"
                                   data-title="Suppression"
                                   data-confirm-message="Souhaitez-vous supprimer cet élément ?">
                                    <i class="fa fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    {% endif %}
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
