{% extends 'back/layout.html.twig' %}

{% block page_title %}Bailleurs{% endblock %}
{% block title %}Bailleurs - {{ parent() }}{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-12">
            <div class="panel panel-inverse">
                <div class="panel-heading ui-sortable-handle">
                    <h4 class="panel-title">Bailleurs</h4>
                    <div class="panel-heading-btn">
                        <a href="{{ path('back_lessors_new') }}"
                           class="btn btn-xs btn-primary open-back-modal"
                           data-modal-title="Edition d'un utilisateur">
                            <i class="fa fa-plus-circle"></i>&nbsp; Ajouter un utilisateur
                        </a>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="table-responsive mb-4">
                        <table class="table table-striped m-b-0">
                            <thead>
                                <tr>
                                    <th>Utilisateur</th>
                                    <th>Email</th>
                                    <th style="width: 150px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for lessor in lessors %}
                                <tr>
                                    <td>{{ lessor.firstname ~ ' ' ~ lessor.lastname }}</td>
                                    <td>{{ lessor.email }}</td>
                                    <td class="pl-4">
                                        <a href="{{ path('back_lessors_edit', {'id': lessor.id}) }}"
                                           class="btn btn-xs btn-primary open-back-modal"
                                           data-modal-title="Edition d'un utilisateur"
                                        >
                                            <i class="fa fa-pencil-alt"></i>
                                        </a>
                                        {% if app.user.id != lessor.id and lessor.isDeletable()  %}
                                            <a href="{{ path('back_lessors_delete', {'id': lessor.id}) }}"
                                               class="btn btn-xs btn-danger post-confirm"
                                               data-button-text="Suppression"
                                               data-title="Suppression"
                                               data-confirm-message="Souhaitez-vous supprimer cet élément ?"><i class="fa fa-trash"></i></a>
                                        {% endif %}
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="navigation">
                        {{ knp_pagination_render(lessors) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
