{% extends 'front/layout.html.twig' %}

{% if app.user %}
    {% set title = "Votre compte" %}
{% else %}
    {% set title = "Création de votre compte" %}
{% endif %}

{% block title %} {{ title }}{% endblock %}

{% block metas %}
    {{ parent() }}
    <meta name="description"
          content="Création de compte gratuit ou avec abonnements, choississez vos centres d'intérêts, trouvez des matchs près de chez vous">
    <meta name="title" content="Gestion de votre compte - Gestion de l'abonnement - Paramétrage compte – Reented">
{% endblock %}

{% block content %}

    <!-- login Area Strat-->
    <section class="login-area pt-50 pb-100">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 offset-lg-2">
                    <div class="basic-login">
                        <h3 class="text-center mb-60">Se connecter</h3>
                        {{ include('front/auth/_form.html.twig') }}
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- login Area End-->

{% endblock %}
