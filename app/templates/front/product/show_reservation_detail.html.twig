                                    {% set picture2 = product.pictures.next %}
                                    <img width="270" height="324"
                                         src="{{ asset('uploads/product_picture/' ~ picture.name)|imagine_filter('product_trends') }}"
                                         alt="product-img">
                                    {% if picture2 %}
                                        <img width="270" height="324" class="product__thumb-2"
                                             src="{{ asset('uploads/product_picture/' ~ picture2.name)|imagine_filter('product_trends') }}"
                                             alt="{{ picture2.name }}">
                                    {% endif %}
                                {% endif %}

                                <div class="product__action transition-3">
                                    <a href="{{ path('front_wishlist_add', {'token': product.token}) }}"
                                       class="post-confirm add-product-wishlist"
                                       data-button-text="Ajouter"
                                       data-title="Favoris"
                                       data-type="green"
                                       data-btn-class="btn-green"
                                       data-confirm-message="Souhaitez-vous ajouter ce produit à vos favoris ?"
                                       data-toggle="tooltip" data-placement="top" title="Ajouter à vos favoris">
                                        <i class="fal fa-heart"></i>
                                    </a>
