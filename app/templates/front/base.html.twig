<!doctype html>
<html class="no-js" lang="fr">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>{% block title %}Rented{% endblock %}</title>
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- Place favicon.ico in the root directory -->
    <link rel="icon" type="image/png" href="{{ asset('favicon.ico') }}" sizes="75x75"/>
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('apple-touch-icon.png') }}">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('favicon-32x32.png') }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('favicon-16x16.png') }}">
    <link rel="manifest" href="{{ asset('site.webmanifest') }}">
    <link rel="mask-icon" href="{{ asset('safari-pinned-tab.svg') }}" color="#2d89ef">
    <meta name="turbo-cache-control" content="no-cache">
    {% block metas %}
        <meta name="keywords" content="">
    {% endblock %}
    <!-- CSS here -->
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
    {#            <script src="{{ app.request.schemeAndHttpHost }}:1337/socket.io/socket.io.js"></script> #}
    <script type="text/javascript">
        const googleGtm = '{{ googleGtm }}';
        const googleTagUa = '{{ googleTagUa }}';
        const stripePublicKey = '{{ stripePublicKey }}';
        const policyUrl = '{{ absolute_url(path('front_policy')) }}';
        let dataLayer = [];
        let isLogged = false;
        let lat = {{ app.request.session.get('lat', 0) }};
        let lon = {{ app.request.session.get('lon', 0) }};
        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
        const userId = '{{ app.user.token }}';
        const lastname = '{{ app.user.lastname }}';
        const firstname = '{{ app.user.firstname }}';
        const email = '{{ app.user.email }}';
        lat = '{{ app.user.lat|default(0) }}';
        lon = '{{ app.user.lon|default(0) }}';
        dataLayer = [{
            'user_id': '{{ app.user.id }}',
            'lastname': '{{ app.user.lastname }}',
            'firstname': '{{ app.user.firstname }}',
            'email': '{{ app.user.email }}',
        }];
        isLogged = true;
        {% endif %}
    </script>
    <script type="text/javascript" src="{{ asset('build/tarteaucitron/tarteaucitron.js') }}"></script>

    {% for file in encore_entry_js_files('app') %}
        <script src="{{ asset(file) }}"></script>
    {% endfor %}
</head>
<body id="page-top" data-turbo-cache="false" {{ stimulus_controller('commun') }}>
<main>{% block body %}{% endblock %}</main>

{% block javascripts %}
    {% for flash_message in app.session.flashBag.get('error') %}
        <script>toastr.error("{{ flash_message }}")</script>
    {% endfor %}
    {% for flash_message in app.session.flashBag.get('success') %}
        <script>toastr.success("{{ flash_message }}")</script>
    {% endfor %}
{% endblock %}
</body>
</html>
