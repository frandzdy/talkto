{% extends 'front/layout.html.twig' %}

{% block title %}
    Accueil, inscription et souscription à un abonnement, Découvrez et partager vos passions,
    centre d'intérêts ou activités favorites
{% endblock %}

{% block metas %}
    {{ parent() }}
    <meta name="description" content="Découvrez les gens que vous avez croisez lors de vos activités favorites,
    trouvez les gens qui on les centre d'intérêts en commun avec vous!">
    <meta name="description" content="Discover the people you’ve crossed paths during your favorite activity,
    find people which have a activity in commun with you!">
{% endblock %}

{% block content %}

    <!-- search area start -->
    {% include('front/partials/_search.html.twig') %}
    <div class="body-overlay transition-3"></div>
    <!-- search area end -->

    <!-- extra info area start -->
    <section class="extra__info transition-3">
        <div class="extra__info-inner">
            <div class="extra__info-close text-right">
                <a href="javascript:void(0);" class="extra__info-close-btn"><i class="fal fa-times"></i></a>
            </div>
            <!-- side-mobile-menu start -->
            <nav class="side-mobile-menu d-block d-lg-none">
                <ul id="mobile-menu-active">
                    <li class="mega-menu active has-dropdown">
                        <a>Catégories</a>
                        <ul class="submenu transition-3"
                            data-background="{{ asset("build/images/img/bg/mega-menu-bg.jpg") }}">
                            {% for index, category in getProductCategories() %}
                                <li>
                                    <a href="{{ path('front_product_category', {'productCategory': index}) }}">{{ category }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </li>
                    <li><a href="javascript:void(0);">Notre Blog</a></li>
                    <li><a href="{{ path('front_contact') }}">Contactez-nous</a></li>
                </ul>
            </nav>
            <!-- side-mobile-menu end -->
        </div>
    </section>
    <div class="body-overlay transition-3"></div>
    <!-- extra info area end -->

    <main>
        <!-- slider area start -->
        <section class="slider__area p-relative">
            <div class="slider-active">
                {% set pictureName = '' %}
                {% if homePage.sliders1 %}
                    {% if homePage.sliders1.pictures.count|default(0) > 0 %}
                        {% set pictureName = homePage.sliders1.pictures.first.name %}
                    {% endif %}
                    <div class="single-slider slider__height d-flex align-items-center"
                         data-background="{{ asset('uploads/product_picture/' ~ pictureName)|imagine_filter('home_slider') }}">
                        <div class="container">
                            <div class="row">
                                <div class="col-xl-6 col-lg-6 col-md-8 col-sm-10 col-12">
                                    <div class="slider__content">
                                        <h2 data-animation="fadeInUp"
                                            data-delay=".2s">{{ homePage.sliders1.title }}</h2>
                                        <p data-animation="fadeInUp"
                                           data-delay=".4s">{{ homePage.sliders1.shortDescription|u.truncate(10, '...', false) }}</p>
                                        <a href="{{ path('front_product_reservation_show_detail', {'token': homePage.sliders1.token}) }}"
                                           class="os-btn os-btn-2" data-animation="fadeInUp"
                                           data-delay=".6s">Réservez</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
                {% if homePage.sliders2 %}
                    {% set pictureName = '' %}
                    {% if homePage.sliders2.pictures.count > 0 %}
                        {% set pictureName = homePage.sliders2.pictures.first.name %}
                    {% endif %}
                    <div class="single-slider slider__height d-flex align-items-center"
                         data-background="{{ asset('uploads/product_picture/' ~ pictureName)|imagine_filter('home_slider') }}">
                        <div class="container">
                            <div class="row">
                                <div class="col-xl-5 col-lg-6 col-md-8 col-sm-10 col-12">
                                    <div class="slider__content">
                                        <h2 data-animation="fadeInUp" data-delay=".2s">{{ homePage.sliders2.title }}
                                        </h2>
                                        <p data-animation="fadeInUp"
                                           data-delay=".4s">{{ homePage.sliders2.shortDescription|u.truncate(10, '...', false) }}</p>
                                        <a href="{{ path('front_product_reservation_show_detail', {'token': homePage.sliders2.token}) }}"
                                           class="os-btn os-btn-2" data-animation="fadeInUp"
                                           data-delay=".6s">Réservez</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
                {% if homePage.sliders3 %}
                    {% set pictureName = '' %}
                    {% if homePage.sliders3.pictures.count > 0 %}
                        {% set pictureName = homePage.sliders3.pictures.first.name %}
                    {% endif %}
                    <div class="single-slider slider__height d-flex align-items-center"
                         data-background="{{ asset('uploads/product_picture/' ~ pictureName)|imagine_filter('home_slider') }}">
                        <div class="container">
                            <div class="row">
                                <div class="col-xl-5 col-lg-6 col-md-8 col-sm-10 col-12">
                                    <div class="slider__content">
                                        <h2 data-animation="fadeInUp"
                                            data-delay=".2s">{{ homePage.sliders3.title }}</h2>
                                        <p data-animation="fadeInUp"
                                           data-delay=".4s">{{ homePage.sliders3.shortDescription|u.truncate(10, '...', false) }}</p>
                                        <a href="{{ path('front_product_reservation_show_detail', {'token': homePage.sliders3.token}) }}"
                                           class="os-btn os-btn-2" data-animation="fadeInUp"
                                           data-delay=".6s">Réservez</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </section>
        <!-- slider area end -->

        <!-- banner area start -->
        <div class="banner__area">
            <div class="container">
                <div class="banner__inner p-relative mt--95">
                    <div class="row">
                        {% if homePage.underSliders1 %}
                            <div class="col-xl-4 col-lg-4 col-md-6">
                                <div class="banner__item mb-30 p-relative">
                                    <div class="banner__thumb fix">
                                        {% set pictureName = '' %}
                                        {% if homePage.underSliders1.pictures.count > 0 %}
                                            {% set pictureName = homePage.underSliders1.pictures.first.name %}
                                        {% endif %}
                                        <a href="{{ path('front_product_reservation_show_detail', {'token': homePage.underSliders1.token}) }}"
                                           class="w-img"><img
                                                    src="{{ asset('uploads/product_picture/' ~ pictureName)|imagine_filter('home_under_slider') }}"
                                                    alt="{{ pictureName }}"></a>
                                    </div>
                                    <div class="banner__content p-absolute transition-3">
                                        <h5>
                                            <a href="{{ path('front_product_reservation_show_detail', {'token': homePage.underSliders1.token}) }}">
                                                {{ homePage.underSliders1.title }}
                                                <br> {{ homePage.underSliders1.author.fullname|capitalize }}
                                            </a>
                                        </h5>
                                        <a href="{{ path('front_product_reservation_show_detail', {'token': homePage.underSliders1.token}) }}"
                                           class="link-btn">
                                            Réservez
                                        </a>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                        {% if homePage.underSliders2 %}
                            <div class="col-xl-4 col-lg-4 col-md-6">
                                <div class="banner__item mb-30 p-relative">
                                    <div class="banner__thumb fix">
                                        {% set pictureName = '' %}
                                        {% if homePage.underSliders2.pictures.count > 0 %}
                                            {% set pictureName = homePage.underSliders2.pictures.first.name %}
                                        {% endif %}
                                        <a href="{{ path('front_product_reservation_show_detail', {'token': homePage.underSliders2.token}) }}"
                                           class="w-img">
                                            <img src="{{ asset('uploads/product_picture/' ~ pictureName)|imagine_filter('home_under_slider') }}"
                                                 alt="{{ pictureName }}">
                                        </a>
                                    </div>
                                    <div class="banner__content p-absolute transition-3">
                                        <h5>
                                            <a href="{{ path('front_product_reservation_show_detail', {'token': homePage.underSliders2.token}) }}">
                                                {{ homePage.underSliders2.title }}
                                                <br> {{ homePage.underSliders2.author.fullname|capitalize }}
                                            </a>
                                        </h5>
                                        <a href="{{ path('front_product_reservation_show_detail', {'token': homePage.underSliders2.token}) }}"
                                           class="link-btn">
                                            Réservez
                                        </a>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                        {% if homePage.underSliders3 %}
                            <div class="col-xl-4 col-lg-4 col-md-6">
                                <div class="banner__item mb-30 p-relative">
                                    <div class="banner__thumb fix">
                                        {% set pictureName = '' %}
                                        {% if homePage.underSliders3.pictures.count > 0 %}
                                            {% set pictureName = homePage.underSliders3.pictures.first.name %}
                                        {% endif %}
                                        <a href="{{ path('front_product_reservation_show_detail', {'token': homePage.underSliders3.token}) }}"
                                           class="w-img">
                                            <img src="{{ asset('uploads/product_picture/' ~ pictureName)|imagine_filter('home_under_slider') }}"
                                                 alt="{{ pictureName }}"></a>
                                    </div>
                                    <div class="banner__content p-absolute transition-3">
                                        <h5>
                                            <a href="{{ path('front_product_reservation_show_detail', {'token': homePage.underSliders3.token}) }}">
                                                {{ homePage.underSliders3.title }}
                                                <br> {{ homePage.underSliders3.author.fullname|capitalize }}
                                            </a>
                                        </h5>
                                        <a href="{{ path('front_product_reservation_show_detail', {'token': homePage.underSliders3.token}) }}"
                                           class="link-btn">
                                            Réservez
                                        </a>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        <!-- banner area end -->

        <!-- product area start -->
        <section class="product__area pt-60 pb-100">
            <div class="container">
                <div class="row">
                    <div class="col-xl-12">
                        <div class="section__title-wrapper text-center mb-55">
                            <div class="section__title mb-10">
                                <h2>Produit tendance</h2>
                            </div>
                            <div class="section__sub-title">
                                <p>Voici une liste des produits le plus visité près de chez vous !</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-xl-12">
                        <div class="product__slider owl-carousel">
                            {% for index, trend in trends %}
                                <div class="product__item">
                                    <div class="product__wrapper mb-60">
                                        <div class="product__thumb">
                                            {% set pictureName = '' %}
                                            {% if trend[0].pictures.count > 0 %}
                                                {% set pictureName = trend[0].pictures.first.name %}
                                            {% endif %}
                                            <img src="{{ asset('uploads/product_picture/' ~ pictureName)|imagine_filter('product_trends_or_sale') }}"
                                                 alt="{{ pictureName }}">
                                            {% if trend[0].pictures.count > 1 %}
                                                {% set pictureName = trend[0].pictures.next.name %}
                                                <img class="product__thumb-2"
                                                     src="{{ asset('uploads/product_picture/' ~ pictureName)|imagine_filter('product_trends_or_sale') }}"
                                                     alt="{{ pictureName }}">
                                            {% endif %}
                                            <div class="product__action transition-3">
                                                <a href="{{ path('front_wishlist_add', {'token': trend[0].token}) }}"
                                                   class="post-confirm add-product-wishlist"
                                                   data-button-text="Ajouter"
                                                   data-title="Favoris"
                                                   data-type="green"
                                                   data-btn-class="btn-green"
                                                   data-confirm-message="Souhaitez-vous ajouter ce produit à vos favoris ?"
                                                   data-toggle="tooltip" data-placement="top"
                                                   title="Ajouter à vos favoris">
                                                    <i class="fal fa-heart"></i>
                                                </a>
                                                <!-- Button trigger modal -->
                                                <a href="{{ path('front_product_reservation', {'token': trend[0].token}) }}"
                                                   title="Réservez"
                                                   data-modal-title="Réservation en cours"
                                                   class="open-product-modal"
                                                   data-lg-size="true">
                                                    <i class="fal fa-search"></i>
                                                </a>
                                            </div>
                                        </div>
                                        <div class="product__content p-relative">
                                            <div class="product__content-inner">
                                                <h4>
                                                    <a href="{{ path('front_product_reservation_show_detail', {'token': trend[0].token}) }}">
                                                        {{ trend[0].title|capitalize }}
                                                    </a>
                                                </h4>
                                                <div class="product__price transition-3">
                                                    <span>{{ trend[0].amount }} €</span>
                                                    {#                                                <span class="old-price">$96.00</span> #}
                                                </div>
                                            </div>
                                            <div class="add-cart p-absolute transition-3">
                                                <a href="{{ path('front_product_reservation', {'token': trend[0].token}) }}"
                                                   title="Réservez"
                                                   data-modal-title="Réservation en cours"
                                                   class="open-product-modal"
                                                   data-lg-size="true"><i
                                                            class="fa fa-shopping-cart"></i> Réservez</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
                {#                <div class="row"> #}
                {#                    <div class="col-xl-12"> #}
                {#                        <div class="product__load-btn text-center mt-25"> #}
                {#                            <a href="#" class="os-btn os-btn-3">Load More</a> #}
                {#                        </div> #}
                {#                    </div> #}
                {#                </div> #}
            </div>
        </section>
        <!-- product area end -->

        <!-- banner area start -->
        <div class="banner__area-2 pb-60">
            <div class="container-fluid p-0">
                <div class="row no-gutters">
                    {% if homePage.mids1 %}
                        <div class="col-xl-6 col-lg-6">
                            <div class="banner__item-2 banner-right p-relative mb-30 pr-15">
                                <div class="banner__thumb fix">
                                    {% set pictureName = '' %}
                                    {% if homePage.mids1.pictures.count > 0 %}
                                        {% set pictureName = homePage.mids1.pictures.first.name %}
                                    {% endif %}
                                    <a href="{{ path('front_product_reservation_show_detail', {'token': homePage.mids1.token}) }}"
                                       class="w-img">
                                        <img src="{{ asset('uploads/product_picture/' ~ pictureName)|imagine_filter('home_mid') }}"
                                             alt="{{ pictureName }}">
                                    </a>
                                </div>
                                <div class="banner__content-2 p-absolute transition-3">
                                    <span>{{ homePage.mids1.category.label }}</span>
                                    <h4>
                                        <a href="{{ path('front_product_reservation_show_detail', {'token': homePage.mids1.token}) }}">
                                            {{ homePage.mids1.title }}
                                        </a>
                                    </h4>
                                    <p>{{ homePage.mids1.shortDescription|u.truncate(20, '...', false) }}</p>
                                    <a href="{{ path('front_product_reservation_show_detail', {'token': homePage.mids1.token}) }}"
                                       class="os-btn os-btn-2">
                                        Réservez /
                                        <span>{{ homePage.mids1.amount|number_format(2, ',')|default(0) }} €</span></a>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                    {% if homePage.mids2 %}
                        <div class="col-xl-6 col-lg-6">
                            <div class=" banner__item-2 banner-left p-relative mb-30 pl-15">
                                <div class="banner__thumb fix">
                                    {% set pictureName = '' %}
                                    {% if homePage.mids2.pictures.count > 0 %}
                                        {% set pictureName = homePage.mids2.pictures.first.name %}
                                    {% endif %}
                                    <a href="{{ path('front_product_reservation_show_detail', {'token': homePage.mids2.token}) }}"
                                       class="w-img">
                                        <img src="{{ asset('uploads/product_picture/' ~ pictureName)|imagine_filter('home_mid') }}"
                                             alt="{{ pictureName }}"></a>
                                </div>
                                <div class="banner__content-2 banner__content-2-right p-absolute transition-3">
                                    <span>{{ homePage.mids2.category.label }}</span>
                                    <h4>
                                        <a href="{{ path('front_product_reservation_show_detail', {'token': homePage.mids2.token}) }}">
                                            {{ homePage.mids2.title }}
                                        </a>
                                    </h4>
                                    <p>{{ homePage.mids2.shortDescription|u.truncate(20, '...', false) }}</p>
                                    <a href="{{ path('front_product_reservation_show_detail', {'token': homePage.mids2.token}) }}"
                                       class="os-btn os-btn-2">
                                        Réservez /
                                        <span>{{ homePage.mids2.amount|number_format(2, ',')|default(0) }} €</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
        <!-- banner area end -->

        <!-- sale off area start -->
        <section class="sale__area pb-100">
            <div class="container">
                <div class="row">
                    <div class="col-xl-12">
                        <div class="section__title-wrapper text-center mb-55">
                            <div class="section__title mb-10">
                                <h2>Top vente</h2>
                            </div>
                            <div class="section__sub-title">
                                <p>Retrouvez les meilleures locations près de chez vous !</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-xl-12">
                        <div class="sale__area-slider owl-carousel">
                            {% for topSale in topSales %}
                                <div class="sale__item">
                                    <div class="product__wrapper mb-60">
                                        <div class="product__thumb">
                                            {% set pictureName = '' %}
                                            {% if topSale[0].product.pictures.count > 0 %}
                                                {% set pictureName = topSale[0].product.pictures.first.name %}
                                            {% endif %}
                                            <img src="{{ asset('uploads/product_picture/' ~ pictureName)|imagine_filter('product_trends_or_sale') }}"
                                                 alt="{{ pictureName }}">
                                            {% if topSale[0].product.pictures.count > 1 %}
                                                {% set pictureName = topSale[0].product.pictures.next.name %}
                                                <img class="product__thumb-2"
                                                     src="{{ asset('uploads/product_picture/' ~ pictureName)|imagine_filter('product_trends_or_sale') }}"
                                                     alt="{{ pictureName }}">
                                            {% endif %}
                                            <div class="product__action transition-3">
                                                <a href="{{ path('front_wishlist_add', {'token': topSale[0].product.token}) }}"
                                                   class="post-confirm add-product-wishlist"
                                                   data-button-text="Ajouter"
                                                   data-title="Favoris"
                                                   data-type="green"
                                                   data-btn-class="btn-green"
                                                   data-confirm-message="Souhaitez-vous ajouter ce produit à vos favoris ?"
                                                   data-toggle="tooltip" data-placement="top"
                                                   title="Ajouter à vos favoris">
                                                    <i class="fal fa-heart"></i>
                                                </a>
                                                <!-- Button trigger modal -->
                                                <a href="{{ path('front_product_reservation', {'token': topSale[0].product.token}) }}"
                                                   title="Réservez"
                                                   data-modal-title="Réservation en cours"
                                                   class="open-product-modal"
                                                   data-lg-size="true">
                                                    <i class="fal fa-search"></i>
                                                </a>

                                            </div>
                                            {#                                            <div class="product__sale"> #}
                                            {#                                                <span class="new">new</span> #}
                                            {#                                                <span class="percent">-16%</span> #}
                                            {#                                            </div> #}
                                        </div>
                                        <div class="product__content p-relative">
                                            <div class="product__content-inner">
                                                <h4>
                                                    <a href="{{ path('front_product_reservation_show_detail', {'token': topSale[0].product.token}) }}">{{ topSale[0].product.title|capitalize }}</a>
                                                </h4>
                                                <div class="product__price transition-3">
                                                    <span>{{ topSale[0].product.amount }} €</span>
                                                    <!--<span class="old-price">$96.00</span>-->
                                                </div>
                                            </div>
                                            <div class="add-cart p-absolute transition-3">
                                                <a href="{{ path('front_product_reservation', {'token': topSale[0].product.token}) }}"
                                                   title="Réservez"
                                                   data-modal-title="Réservation en cours"
                                                   class="open-product-modal"
                                                   data-lg-size="true"><i
                                                            class="fa fa-shopping-cart"></i> Réservez</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- sale off area end -->

        <!-- client slider area start -->
        <section class="client__area pt-15 pb-140">
            <div class="container">
                <div class="row">
                    <div class="col-xl-12">
                        <div class="client__slider owl-carousel text-center">
                            {% for latestProduct in latestProducts %}
                                {% set pictureName = '' %}
                                {% if latestProduct[0].pictures.count > 0 %}
                                    {% set pictureName = latestProduct[0].pictures.first.name %}
                                {% endif %}
                                <div class="client__thumb">
                                    <a href="{{ path('front_product_reservation_show_detail', {'token': latestProduct[0].token}) }}">
                                        <img src="{{ asset('uploads/product_picture/' ~ pictureName)|imagine_filter('home_latest') }}"
                                             alt="{{ pictureName }}"></a>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- client slider area end -->

