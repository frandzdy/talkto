{% extends 'front/layout.html.twig' %}

{% if app.user %}
    {% set title = "Mon compte" %}
{% else %}
    {% set title = "Nouveau compte" %}
{% endif %}

{% block title %} {{ title ~ ' | ' ~ parent() }} {% endblock %}

{% block metas %}
    {{ parent() }}
    <meta name="description"
          content="Création de compte gratuit ou avec abonnements, choissisez vos centres d'intérêts, trouvez des matchs près de chez vous">
    <meta name="title" content="Gestion de votre compte - Gestion de l'abonnement - Paramétrage compte – Spami">
{% endblock %}

{% set breadcrumbTitle = app.user ? 'Mon compte' : 'Nouveau compte' %}
{% set breadcrumbItems =
    {
        breadcrumbTitle: ''
    }
%}

{% block content %}
    {{ include('partials/_breadcrumbs.html.twig') }}
    <!-- login Area Strat-->
    <section class="login-area pt-100 pb-100">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 offset-lg-2">
                    <div class="basic-login">
                        <h3 class="text-center mb-60">Signup From Here</h3>
                        {{ form_start(form) }}
                        <div class="custom-file">
                            {{ form_row(form.picture) }}
                        </div>
                        <div class="mt-10"></div>
                        {{ form_row(form.genre) }}
                        {{ form_row(form.email) }}
                        {{ form_row(form.lastname) }}
                        {{ form_row(form.firstname) }}
                        <div class="mt-10"></div>
                        {{ form_row(form.city) }}
                        {# <small class="form-text text-muted"> #}
                        {#    Si vous n'acceptez pas la géolocalisation, nous utilisons cette information. #}
                        {# </small> #}
                        {{ form_row(form.description) }}
                        {# <small class="form-text text-muted"> #}
                        {#    Pour votre santé 😉 nous avons mis par défaut que vous étiez non-fumeur 🚬. #}
                        {# </small> #}
                        <div class="mt-10"></div>
                        {{ form_row(form.plainPassword) }}
                        <div class="mt-10"></div>
                        {% if not app.user %}
                            <button class="os-btn w-100" formnovalidate>S'inscrire</button>
                            <div class="or-divide"><span>ou</span></div>
                            <a href="{{ path('front_login') }}" class="os-btn os-btn-black w-100">Se connecter</a>
                        {% else %}
                            <button class="os-btn w-100" formnovalidate>Modifier</button>
                        {% endif %}
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- login Area End-->




{% endblock %}
