{% extends 'front/layout.html.twig' %}

{% block title %}Nouveau compte loueur{% endblock %}

{% block metas %}
    {{ parent() }}
    <meta name="description"
          content="Création d'un compte bailleur afin proposer des produits.">
    <meta name="title" content="Nouveau compte bailleur">
{% endblock %}

{% set breadcrumbTitle = app.user ? 'Mon compte bailleur' : 'Nouveau compte' %}
{% set breadcrumbItems =
    {
        breadcrumbTitle: ''
    }
%}

{% block content %}
    {{ include('partials/_breadcrumbs.html.twig') }}
    <!-- login Area Strat-->
    <section class="login-area pt-100 pb-100" {{ stimulus_controller('user') }}>
        <div class="container">
            <div class="row">
                <div class="col-lg-8 offset-lg-2">
                    <div class="basic-login">
                        <h3 class="text-center mb-60">{{ app.user ? 'Mes informations' : 'S\'inscrire' }} </h3>
                        {{ include('front/user/partials/_form.html.twig') }}
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- login Area End-->
{% endblock %}
