{% for product in collections.products.results %}
    <tr>
        <td class="text-center order__id">#3520</td>
        <td class="text-center"><a href="{{ path('front_product_show', {'token': product.token}) }}"
                                   class="order__title">{{ product.title }}</a></td>
        <td class="text-center">{{ product.amount }} €</td>
        <td class="text-center">{{ product.status.label }}</td>
        <td class="text-center">
            <a href="{{ path('front_product_show', {'token': product.token}) }}"
               class="order__view-btn open-product-modal"
               data-modal-title="Prévisualiser le produit {{ product.title }}"
               title="Prévisualiser le produit {{ product.title }}">Prévisualiser</a>
            <br>
            <a href="{{ path('front_product_edit', {'token': product.token}) }}"
               class="order__info-btn open-product-modal"
               title="Modification du produit {{ product.title }}"
               data-modal-title="Modification du produit {{ product.title }}"
            >
                Modifier
            </a>
            <br>
            <a href="{{ path('front_product_delete', {'token': product.token}) }}" class="order__view-btn post-confirm"
               data-confirm-message="Etes-vous sur de vouloir supprimer le produit {{ product.title }} ?"
               data-title="Suppression du produit {{ product.title }}"
               data-button-text="Supprimer"
               title="Suppression du produit {{ product.title }}"
            >
                Supprimer
            </a>
        </td>
    </tr>
{% endfor %}