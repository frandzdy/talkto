{% set pictureName = '' %}
{% if user.picture is not null %}
    {% set pictureName = user.picture.name %}
{% endif %}
{% set currentRoute = app.request.attributes.get('_route') %}
<div class="profile__edit-wrapper" {{ user.roles[0] == constant('App\\Entity\\User::ROLE_SELLER') ? 'data-turbo="false"' : '' }}>
    {{ form_start(form, {attr: {'data-user-target': 'userForm', 'data-action': 'user#checkRecaptcha', 'autocomplete':'off'} }) }}
    <div class="row">
        <div class="col-3 profile__basic-thumb valign-items-center">
            <img src="{{ pictureName ? asset('uploads/profile_picture/' ~ pictureName)|imagine_filter('profil') : 'https://bootdey.com/img/Content/avatar/avatar2.png' }}"
                 alt="{{ pictureName ?: 'avatar' }}">
        </div>
        <div class="col-8" style="margin-top: 23px">
            {{ form_row(form.uploadPicture) }}
        </div>
    </div>
    <div class="product__modal-input">
        {{ form_row(form.genre) }}
    </div>
    <div class="profile__edit-input">
        {{ form_row(form.email) }}
    </div>
    <div class="profile__edit-input">
        {{ form_row(form.lastname) }}
    </div>
    <div class="profile__edit-input">
        {{ form_row(form.firstname) }}
    </div>
    <div class="profile__edit-input">
        {{ form_row(form.address) }}
        <div class="zone-address w-100">
            <ul class="address d-none" style="list-style: none">
            </ul>
        </div>
    </div>
    <div class="profile__edit-input">
        {{ form_row(form.additionalAddress) }}
    </div>
    <div class="profile__edit-input">
        {{ form_row(form.zipCode) }}
    </div>
    <div class="profile__edit-input">
        {{ form_row(form.city) }}
    </div>
    <div class="profile__edit-input">
        {{ form_row(form.country) }}
    </div>
    <div class="profile__edit-input">
        {{ form_row(form.phone) }}
    </div>
    <div class="profile__edit-input">
        {{ form_row(form.plainPassword) }}
    </div>
    {% if not app.user %}
        <div class="login-action mb-20 fix">
            <span class="log-rem f-left">
                {{ form_row(form.terms) }}
            </span>
            {% if currentRoute is not same as ('front_seller_new') %}
                <span class="forgot-login f-right">
                    <a href="{{ path('front_seller_new') }}">Vous aussi devenez bailleur !</a>
                </span>
            {% endif %}
        </div>
        <button class="os-btn w-100" formnovalidate>S'inscrire</button>
        <div class="or-divide"><span>ou</span></div>
        <a href="{{ path('front_login') }}" class="os-btn os-btn-black w-100">Se connecter</a>
    {% else %}
        <button class="os-btn w-100" formnovalidate>Modifier</button>
    {% endif %}
    {{ form_end(form) }}
</div>
