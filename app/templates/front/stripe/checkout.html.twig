                <div class="col-lg-6">
                    <div class="your-order mb-30 ">
                        <h3>Vos réservations</h3>
                        <div class="your-order-table table-responsive">
                            <table>
                                <thead>
                                <tr>
                                    <th class="product-name">Produit</th>
                                    <th class="product-total">Total</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for cart in carts['products'] %}
                                    <tr class="cart_item">
                                        <td class="product-name">
                                            Date de réservation : <br>
                                            {{ cart.flatpickrDate }}<br>
                                            {{ cart.title }} <strong class="product-quantity">
                                                × {{ cart.quantity }}</strong>
                                        </td>
                                        <td class="product-total">
                                            <span class="amount">{{ cart.price * cart.quantity * cart.numberDays }} €</span>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                                <tfoot>
                                <tr class="cart-subtotal">
                                    <th>Sous total HT</th>
                                    <td><span class="amount">{{ carts.totalAmount - carts.totalTva }} €</span></td>
                                </tr>
                                <tr class="shipping">
                                    <th>T.V.A (20%)</th>
                                    <td>
                                        <ul>
                                            <li>
                                                <label>
                                                     <span class="amount">{{ carts.totalTva }} €</span>
                                                </label>
                                            </li>
                                        </ul>
                                    </td>
                                </tr>
                                <tr class="order-total">
                                    <th>Total TTC</th>
                                    <td><strong><span class="amount">{{ carts.totalAmount }} €</span></strong>
                                    </td>
                                </tr>
                                </tfoot>
                            </table>
                        </div>

