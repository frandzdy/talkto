{{ form_start(form, {'attr': {'autocomplete':'off', 'id': 'user-reservation-form'}}) }}
<div class="row">
    <div class="col-md-12">
        <div class="checkout-form-list">
            {{ form_widget(form.genre) }}
            {{ form_errors(form.genre) }}
        </div>
    </div>
    <div class="col-md-6">
        <div class="checkout-form-list">
            {{ form_widget(form.firstname) }}
            {{ form_errors(form.firstname) }}
        </div>
    </div>
    <div class="col-md-6">
        <div class="checkout-form-list">
            {{ form_widget(form.lastname) }}
            {{ form_errors(form.lastname) }}
        </div>
    </div>
    <div class="col-md-12">
        <div class="checkout-form-list">
            {{ form_widget(form.address) }}
            {{ form_errors(form.address) }}
        </div>
    </div>
    <div class="col-md-12">
        <div class="checkout-form-list">
            {{ form_widget(form.additionalAddress) }}
        </div>
    </div>
    <div class="col-md-12">
        <div class="checkout-form-list">
            {{ form_widget(form.city) }}
            {{ form_errors(form.city) }}
        </div>
    </div>
    <div class="col-md-6">
        <div class="checkout-form-list">
            {{ form_widget(form.country) }}
            {{ form_errors(form.country) }}
        </div>
    </div>
    <div class="col-md-6">
        <div class="checkout-form-list">
            {{ form_widget(form.zipCode) }}
            {{ form_errors(form.zipCode) }}
        </div>
    </div>
    <div class="col-md-6">
        <div class="checkout-form-list">
            {{ form_widget(form.email) }}
            {{ form_errors(form.email) }}
        </div>
    </div>
    <div class="col-md-6">
        <div class="checkout-form-list">
            {{ form_widget(form.phone) }}
            {{ form_errors(form.phone) }}
        </div>
    </div>
    {% if not app.user %}
        <div class="col-md-12">
            <div class="checkout-form-list create-acc">
                {{ form_widget(form.isGuess) }}
            </div>
            <div id="cbox_info" class="checkout-form-list create-account">
                <p>Créer un compte en indiquant les informations ci-dessus.
                    Create an account by entering the information below.
                    Si vous êtes déjà client, veuillez vous connectez au haut de cette page.
                    If you are a returning
                    customer please login at the top of the page.</p>
                {{ form_widget(form.plainPassword) }}
                {{ form_errors(form.plainPassword) }}
            </div>
        </div>
        <div class="col-md-12">
            <button type="submit" class="os-btn os-btn-black" formnovalidate="formnovalidate">Valider</button>
        </div>
    {% endif %}
    {{ form_rest(form) }}
</div>
{{ form_end(form) }}