<form action="{{ path('front_stripe_payment_user_login') }}" method="POST">
    <p class="form-row-first">
        <label>E-mail <span class="required">*</span></label>
        <input type="email" name="email" value="{{ last_username }}" placeholder="email@exemple.fr" required autofocus/>
    </p>
    <p class="form-row-last">
        <label>Mot de passe <span class="required">*</span></label>
        <input name="password" type="password" placeholder="Mot de passe" />
    </p>
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('front_login') }}">
    <p class="form-row">
        <button class="os-btn os-btn-black" type="submit">Se connecter</button>
    </p>
    <p class="lost-password">
        <a href="{{ path('front_forgot_password_request') }}">Mot de passe oublié ?</a>
    </p>
</form>