<!-- checkout-area start -->
<section class="checkout-area pb-70">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="your-order mb-30 text-center">
                    <h3>Votre location {{ reservation.transaction ? reservation.transaction.reference : '' }}</h3>
                    <div class="your-order-table table-responsive">
                        <table>
                            <thead>
                            <tr>
                                <th class="product-name">Photo</th>
                                <th class="product-name">Produit</th>
                                <th class="product-name">Etat</th>
                                <th class="product-total">Total</th>
                                <th class="product-name">Action</th>
                            </tr>
                            </thead>
                            <tbody>
                                <tr class="cart_item">
                                    <td class="product-thumbnail">
                                        <a href="{{ path('front_product_show_detail', {'token': transactionLine.product.token }) }}">
                                            <img src="{{ asset('uploads/product_picture/' ~ transactionLine.product.pictures.first.name)|imagine_filter('product_miniature') }}"
                                                 alt="{{ transactionLine.product.pictures.first.name }}"/>
                                        </a>
                                    </td>
                                    <td class="product-name">
                                        Date de réservation : <br>
                                        {% if transactionLine.startDate|date('d/m/Y') != transactionLine.endDate|date('d/m/Y') %}
                                            {{ transactionLine.startDate|date('d/m/Y') }} au {{ transactionLine.endDate|date('d/m/Y') }}
                                            <br>
                                        {% else %}
                                            {{ transactionLine.startDate|date('d/m/Y') }}
                                        {% endif %}
                                        {{ transactionLine.product.title }} <strong class="product-quantity">
                                            × {{ transactionLine.quantity }}</strong>
                                    </td>
                                    <td class="product-name">
                                        {{ transactionLine.status.label }}
                                    </td>
                                    <td class="product-total">
                                        <span class="amount">{{ transactionLine.amountTtc / 100 }} €</span>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                            <tr class="cart-subtotal">
                                <th></th>
                                <th></th>
                                <th>Sous total HT</th>
                                <td>
                                    <span class="amount">{{ (transactionLine.amountTtc - transactionLine.amountTva) / 100 }} €</span>
                                </td>
                                <td></td>
                            </tr>
                            <tr class="shipping">
                                <th></th>
                                <th></th>
                                <th>T.V.A (20%)</th>
                                <td>
                                    <ul>
                                        <li>
                                            <label>
                                                <span class="amount">{{ transactionLine.amountTva / 100 }} €</span>
                                            </label>
                                        </li>
                                    </ul>
                                </td>
                                <td></td>
                            </tr>
                            <tr class="shipping">
                                <th></th>
                                <th></th>
                                <th>Frais de service</th>
                                <td>
                                    <ul>
                                        <li>
                                            <label>
                                                <span class="amount">{{ transactionLine.fees / 100 }} €</span>
                                            </label>
                                        </li>
                                    </ul>
                                </td>
                                <td></td>
                            </tr>
                            <tr class="order-total">
                                <th></th>
                                <th></th>
                                <th>Total TTC</th>
                                <td><strong><span
                                                class="amount">{{ transactionLine.amountTtc + transactionLine.fees / 100 }} €</span></strong>
                                </td>
                                <td></td>
                            </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- checkout-area end -->
