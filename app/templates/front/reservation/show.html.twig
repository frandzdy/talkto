<!-- checkout-area start -->
<section class="checkout-area pb-70">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="your-order mb-30 text-center">
                    <h3>Votre réservation {{ reservation.transaction ? reservation.transaction.reference : '' }}</h3>
                    <div class="your-order-table table-responsive">
                        <table>
                            <thead>
                            <tr>
                                <th class="product-name">Photo</th>
                                <th class="product-name">Produit</th>
                                <th class="product-name">Etat</th>
                                <th class="product-total">Total</th>
                                <th class="product-name">Action</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for transactionLine in reservation.transaction.transactionLines %}
                                {% set pictureName = '' %}
                                {% if transactionLine.product.pictures.count > 0 %}
                                    {% set pictureName = transactionLine.product.pictures.first.name %}
                                {% endif %}
                                <tr class="cart_item">
                                    <td class="product-thumbnail">
                                        <a href="{{ path('front_product_reservation_show_detail', {'token': transactionLine.product.token }) }}"
                                           title=" {{ pictureName }}">
                                            <img src="{{ asset('uploads/product_picture/' ~ pictureName)|imagine_filter('product_miniature') }}"
                                                 alt="{{ pictureName }}"/>
                                        </a>
                                    </td>
                                    <td class="product-name">
                                        Date de réservation : <br>
                                        {% if transactionLine.startDate|date('d/m/Y') != transactionLine.endDate|date('d/m/Y') %}
                                            {{ transactionLine.startDate|date('d/m/Y') }} au {{ transactionLine.endDate|date('d/m/Y') }}
                                            <br>
                                        {% else %}
                                            {{ transactionLine.startDate|date('d/m/Y') }}
                                        {% endif %}
                                        {{ transactionLine.product.title }} <strong class="product-quantity">
                                            × {{ transactionLine.quantity }}</strong>
                                    </td>
                                    <td class="product-name">
                                        {{ transactionLine.status.label }}
                                    </td>
                                    <td class="product-total">
                                        <span class="amount">{{ transactionLine.amountTtc / 100 }} €</span>
                                    </td>
                                    <td class="product-name">
                                        {% if transactionLine.status.value is not same as (constant('App\\Enum\\TransactionLineStatus::CANCELED').value) %}
                                            {% if not app.user.isStripeAccountActive %}
                                                {% if transactionLine.endDate|date('d/m/Y') <= "now"|date("d/m/Y")
                                                    or transactionLine.status.value == constant('App\\Enum\\TransactionLineStatus::VALIDATE').value %}
                                                    <a class="profile__info-btn post-confirm"
                                                       data-button-text="Annuler"
                                                       data-toggle="tooltip" data-placement="top"
                                                       data-title="Annulation"
                                                       data-confirm-message="Souhaitez-vous faire ouvrir un litige ?"
                                                       href="{{ path('front_claim_create', {'token': transactionLine.token}) }}"
                                                       title="Faire une litige">
                                                        Litige
                                                    </a>
                                                    <br>
                                                {% endif %}
                                            {% else %}
                                                {% if transactionLine.startDate|date('d/m/Y') == "now"|date("d/m/Y") or transactionLine.getCheck(constant('App\\Enum\\CheckinType::IN'))|length == 0 %}
                                                    <a class="profile__info-btn open-front-modal"
                                                       data-toggle="tooltip" data-placement="top"
                                                       href="{{ path('front_check_create', {'type': 'in', 'token': transactionLine.token}) }}"
                                                       title="Check-in"
                                                       data-modal-title="Check-in">
                                                        Check-in
                                                    </a>
                                                    <br>
                                                {% endif %}
                                                {% if transactionLine.endDate|date('d/m/Y') <=  "now"|date("d/m/Y") or transactionLine.getCheck(constant('App\\Enum\\CheckinType::OUT'))|length == 0 %}
                                                    <a class="profile__info-btn open-front-modal"
                                                       data-toggle="tooltip" data-placement="top"
                                                       href="{{ path('front_check_create', {'type': 'out', 'token': transactionLine.token}) }}"
                                                       title="Check-out"
                                                       data-modal-title="Check-out">
                                                        Checkout
                                                    </a>
                                                    <br>
                                                {% endif %}
                                            {% endif %}
                                            {% if transactionLine.canBeCancel %}
                                                <a class="profile__info-btn post-confirm"
                                                   data-button-text="Annuler"
                                                   data-toggle="tooltip" data-placement="top"
                                                   data-title="Annulation"
                                                   data-confirm-message="Souhaitez-vous annuler cette réservation ?"
                                                   href="{{ path('front_transaction_line_delete', {'token': transactionLine.token}) }}"
                                                   title="Annuler votre réservation">Annulation</a>
                                                <br>
                                            {% endif %}
                                            <a class="profile__info-btn open-front-modal" type="button"
                                               data-lg-size="true"
                                               data-toggle="tooltip" data-placement="top"
                                               href="{{ url('front_chat_index', {'token': reservation.token, 'transactionLineToken': transactionLine.token}, true) }}"
                                               data-modal-title="Chat"
                                               title="Chat">
                                                Chat
                                            </a>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                            <tfoot>
                            <tr class="cart-subtotal">
                                <th></th>
                                <th></th>
                                <th>Sous total HT</th>
                                <td>
                                    <span class="amount">{{ (reservation.transaction.totalAmountTtc - reservation.transaction.totalAmountTva - reservation.transaction.totalFees) / 100 }} €</span>
                                </td>
                                <td></td>
                            </tr>
                            <tr class="shipping">
                                <th></th>
                                <th></th>
                                <th>T.V.A (20%)</th>
                                <td>
                                    <ul>
                                        <li>
                                            <label>
                                                <span class="amount">{{ reservation.transaction.totalAmountTva / 100 }} €</span>
                                            </label>
                                        </li>
                                    </ul>
                                </td>
                                <td></td>
                            </tr>
                            <tr class="shipping">
                                <th></th>
                                <th></th>
                                <th>Frais de service</th>
                                <td>
                                    <ul>
                                        <li>
                                            <label>
                                                <span class="amount">{{ reservation.transaction.totalFees / 100 }} €</span>
                                            </label>
                                        </li>
                                    </ul>
                                </td>
                                <td></td>
                            </tr>
                            <tr class="order-total">
                                <th></th>
                                <th></th>
                                <th>Total TTC</th>
                                <td>
                                    <strong>
                                        <span class="amount">
                                            {{ (reservation.transaction.totalAmountTtc / 100)|number_format(2, ',')|default(0) }} €
                                        </span>
                                    </strong>
                                </td>
                                <td></td>
                            </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- checkout-area end -->
