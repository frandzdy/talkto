<!-- page title area start -->
<section class="page__title p-relative d-flex align-items-center" style="background: #f5f5f5;border-top: 1px solid #e4e4e4;">
    <div class="container">
        <div class="row">
            <div class="col-xl-12">
                <div class="page__title-inner text-center">
                    <h1>{{ breadcrumbTitle }}</h1>
                    <div class="page__title-breadcrumb">
                        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
                            <ol class="breadcrumb justify-content-center">
                                <li class="breadcrumb-item"><a href="{{ path('front_home') }}">Accueil</a></li>
                                {% for label, url in breadcrumbItems|default({}) %}
                                    {% if url %}
                                        <li class="breadcrumb-item active"><a href="{{ url }}"
                                                                       title="{{ label }}">{{ label }}</a>
                                        </li>
                                    {% else %}
                                        <li class="breadcrumb-item active">{{ label }}</li>
                                    {% endif %}
                                {% endfor %}
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- page title area end -->